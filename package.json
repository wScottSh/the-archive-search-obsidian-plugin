{
	"name": "the-archive-search-obsidian-plugin",
	"version": "0.2.1",
	"description": "Obsidian plugin replicating The Archive's Omnibar search with boolean queries, wiki-link-as-search, and note creation.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"zettelkasten",
		"search",
		"the-archive"
	],
	"author": "Scott Sheppard",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4",
		"vitest": "^1.0.0"
	}
}
